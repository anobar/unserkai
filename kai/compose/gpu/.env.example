# Kai GPU-Stack: Variablen fuer die Compose-Interpolation.
# Der Stack braucht keine Geheimnisse; Ansible schreibt diese Werte aus
# kai_gpu_bind, kai_gpu_port und kai_models_dir nach stack.env.

# Adresse und Port, auf denen llama-swap lauscht (VPC-Adresse der Maschine).
KAI_GPU_BIND=127.0.0.1
KAI_GPU_PORT=8080

# Verzeichnis mit den GGUF-Dateien (Volume kai-models, Label-Mount).
KAI_MODELS_DIR=/opt/kai/models
