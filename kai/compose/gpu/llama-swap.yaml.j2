# llama-swap fuer {{ inventory_hostname }}; von Ansible aus kai_gpu_models erzeugt.
healthCheckTimeout: {{ kai_gpu_health_check_timeout | default(600) }}
logLevel: info
models:
{% for m in kai_gpu_models %}
  {{ m.name }}:
    cmd: >
      llama-server --host 127.0.0.1 --port ${PORT}
      --model /models/{{ m.file }}
      --ctx-size {{ m.ctx_size }} --parallel {{ m.parallel | default(4) }}
      -fa on --jinja -ngl {{ 999 if kai_gpu_enabled | default(true) else 0 }}
{% if m.reasoning_effort is defined %}
      --chat-template-kwargs '{"reasoning_effort":"{{ m.reasoning_effort }}"}'
{% endif %}
    ttl: {{ m.ttl | default(0) }}
{% endfor %}
