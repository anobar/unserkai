#!/usr/bin/env bash
# kai-smoke: post-deployment smoke test for the Kai entry stack.
# Run ON kai-entry. Checks compose health, HTTP endpoints, and a chat completion.
# Options:
#   --webui-url URL       Open WebUI base URL (default http://127.0.0.1:3000)
#   --litellm-url URL     LiteLLM base URL (default http://127.0.0.1:4000)
#   --gpu-url URL         Direct GPU model server base URL (default empty = skip)
#   --env-file FILE       Env file to read LITELLM_MASTER_KEY from (default /opt/kai/.env)
#   --compose-dir DIR     Compose project directory (default /opt/kai)
#   --model ID            Model id for the chat call (default: first id from /v1/models)
#   --timeout SECONDS     curl --max-time for the chat call (default 180)
#   --no-chat             Skip the chat completion check
#   -h|--help             Print this usage and exit 0
set -euo pipefail

usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
}

failures=0

pass() {
  printf '[PASS] %s\n' "$1"
}

fail() {
  printf '[FAIL] %s: %s\n' "$1" "$2"
  failures=$((failures + 1))
}

skip() {
  printf '[SKIP] %s: %s\n' "$1" "$2"
}

webui_url=http://127.0.0.1:3000
litellm_url=http://127.0.0.1:4000
gpu_url=
env_file=/opt/kai/.env
compose_dir=/opt/kai
model=
timeout=180
no_chat=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --webui-url)
      webui_url=$2
      shift 2
      ;;
    --litellm-url)
      litellm_url=$2
      shift 2
      ;;
    --gpu-url)
      gpu_url=$2
      shift 2
      ;;
    --env-file)
      env_file=$2
      shift 2
      ;;
    --compose-dir)
      compose_dir=$2
      shift 2
      ;;
    --model)
      model=$2
      shift 2
      ;;
    --timeout)
      timeout=$2
      shift 2
      ;;
    --no-chat)
      no_chat=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'error: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

tmpfile=$(mktemp)
trap 'rm -f "$tmpfile"' EXIT

# Read LITELLM_MASTER_KEY from env file if not already set in environment.
if [[ -z ${LITELLM_MASTER_KEY:-} ]]; then
  if [[ -f "$env_file" ]]; then
    # The env file is 0600 root, so a normal user reads it through sudo.
    if [[ -r "$env_file" ]]; then
      LITELLM_MASTER_KEY=$(grep '^LITELLM_MASTER_KEY=' "$env_file" | head -1 | cut -d'=' -f2- || true)
    else
      LITELLM_MASTER_KEY=$(sudo grep '^LITELLM_MASTER_KEY=' "$env_file" | head -1 | cut -d'=' -f2- || true)
    fi
  fi
fi

# Check 1: compose-health
if command -v docker >/dev/null 2>&1; then
  compose_file="$compose_dir/compose.yaml"
  stack_env="$compose_dir/stack.env"
  if [[ ! -f "$compose_file" ]]; then
    skip compose-health "compose file not found: $compose_file"
  elif [[ ! -f "$stack_env" ]]; then
    skip compose-health "stack env file not found: $stack_env"
  else
    if [[ $EUID -ne 0 ]]; then
      ps_output=$(sudo docker compose -f "$compose_file" --env-file "$env_file" --env-file "$stack_env" ps --format '{{.Name}} {{.Health}}' 2>&1) || {
        fail compose-health "docker compose ps failed: $ps_output"
        ps_output=
      }
    else
      ps_output=$(docker compose -f "$compose_file" --env-file "$env_file" --env-file "$stack_env" ps --format '{{.Name}} {{.Health}}' 2>&1) || {
        fail compose-health "docker compose ps failed: $ps_output"
        ps_output=
      }
    fi
    if [[ -n "$ps_output" ]]; then
      unhealthy=0
      while IFS= read -r line; do
        if [[ -z "$line" ]]; then
          continue
        fi
        health=${line##* }
        if [[ "$health" != "healthy" ]]; then
          unhealthy=1
          break
        fi
      done <<< "$ps_output"
      if [[ $unhealthy -eq 1 ]]; then
        fail compose-health "one or more services are not healthy"
      else
        pass compose-health
      fi
    fi
  fi
else
  skip compose-health "docker not available"
fi

# Check 2: open-webui-health
http_code=$(curl -sS -o "$tmpfile" -w '%{http_code}' "$webui_url/health" 2>/dev/null) || http_code=000
if [[ "$http_code" == "200" ]]; then
  pass open-webui-health
else
  fail open-webui-health "HTTP $http_code"
fi

# Check 3: litellm-liveliness
http_code=$(curl -sS -o "$tmpfile" -w '%{http_code}' "$litellm_url/health/liveliness" 2>/dev/null) || http_code=000
if [[ "$http_code" == "200" ]]; then
  pass litellm-liveliness
else
  fail litellm-liveliness "HTTP $http_code"
fi

# Check 4: litellm-models
if [[ -n ${LITELLM_MASTER_KEY:-} ]]; then
  http_code=$(curl -sS -o "$tmpfile" -w '%{http_code}' -H "Authorization: Bearer $LITELLM_MASTER_KEY" "$litellm_url/v1/models" 2>/dev/null) || http_code=000
  if [[ "$http_code" == "200" ]]; then
    model_ids=$(grep -o '"id":"[^"]*"' "$tmpfile" | head -1 | cut -d'"' -f4 || true)
    if [[ -n "$model_ids" ]]; then
      pass litellm-models
      if [[ -z "$model" ]]; then
        model=$model_ids
      fi
    else
      fail litellm-models "no model ids in response"
    fi
  else
    fail litellm-models "HTTP $http_code"
  fi
else
  skip litellm-models "LITELLM_MASTER_KEY not set"
fi

# Check 5: gpu-models
if [[ -n "$gpu_url" ]]; then
  http_code=$(curl -sS -o "$tmpfile" -w '%{http_code}' "$gpu_url/v1/models" 2>/dev/null) || http_code=000
  if [[ "$http_code" == "200" ]]; then
    pass gpu-models
  else
    fail gpu-models "HTTP $http_code"
  fi
else
  skip gpu-models "gpu-url not set"
fi

# Check 6: chat
if [[ $no_chat -eq 1 ]]; then
  skip chat "--no-chat specified"
elif [[ -z ${LITELLM_MASTER_KEY:-} ]]; then
  skip chat "LITELLM_MASTER_KEY not set"
elif [[ -z "$model" ]]; then
  skip chat "no model available"
else
  start_time=$(date +%s)
  http_code=$(curl -sS -o "$tmpfile" -w '%{http_code}' --max-time "$timeout" \
    -H "Authorization: Bearer $LITELLM_MASTER_KEY" \
    -H "Content-Type: application/json" \
    -d "{\"model\":\"$model\",\"messages\":[{\"role\":\"user\",\"content\":\"Reply with one word.\"}],\"max_tokens\":32}" \
    "$litellm_url/v1/chat/completions" 2>/dev/null) || http_code=000
  end_time=$(date +%s)
  elapsed=$((end_time - start_time))
  if [[ "$http_code" == "200" ]] && grep -q '"choices"' "$tmpfile"; then
    pass "chat (${elapsed}s)"
  else
    fail "chat (${elapsed}s)" "HTTP $http_code"
  fi
fi

if [[ $failures -eq 0 ]]; then
  printf 'kai-smoke: all checks passed\n'
  exit 0
else
  printf 'kai-smoke: %d check(s) failed\n' "$failures"
  exit 1
fi
