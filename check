#!/usr/bin/env bash
# Step functions are called indirectly via run_step.
# shellcheck disable=SC2317
set -euo pipefail

cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
export LC_ALL=C.UTF-8 LANG=C.UTF-8

usage() {
  cat <<EOF
Usage: check [-h|--help] [--only <step>]

Steps: ansible-lint, yamllint, shellcheck, compose, gitleaks, private-addresses
EOF
}

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing tool: $1" >&2
    return 1
  fi
}

step_ansible-lint() {
  need ansible-lint || return 1
  (cd ansible && ansible-lint)
}

step_yamllint() {
  need yamllint || return 1
  local -a files=()
  mapfile -d '' -t files < <(git ls-files -z -- 'ansible/*.yml' 'ansible/*.yaml' 'kai/*.yml' 'kai/*.yaml')
  if [[ ${#files[@]} -eq 0 ]]; then
    echo "note: no yamllint files found"
    return 0
  fi
  if [[ -f .yamllint ]]; then
    yamllint -s "${files[@]}"
  else
    yamllint -s -d '{extends: default, rules: {line-length: disable, document-start: disable, truthy: {check-keys: false}, comments: {min-spaces-from-content: 1}}}' "${files[@]}"
  fi
}

step_shellcheck() {
  need shellcheck || return 1
  local -a files=()
  while IFS= read -r -d '' f; do
    [[ -f "$f" ]] || continue
    [[ "$f" == bootstrap/* || "$f" == aws/* ]] && continue
    if [[ "$f" == *.sh ]]; then
      files+=("$f")
    elif head -n1 "$f" | grep -qE '^#!.*\b(ba)?sh\b'; then
      files+=("$f")
    fi
  done < <(git ls-files -z)
  if [[ ${#files[@]} -eq 0 ]]; then
    echo "note: no shellcheck files found"
    return 0
  fi
  shellcheck -x "${files[@]}"
}

step_compose() {
  need docker || return 1
  local -a files=()
  mapfile -d '' -t files < <(git ls-files -z -- 'kai/compose/*/compose.yaml')
  if [[ ${#files[@]} -eq 0 ]]; then
    return 2
  fi
  local failed=0
  for f in "${files[@]}"; do
    local dir
    dir="$(dirname "$f")"
    if [[ ! -f "$dir/.env.example" ]]; then
      echo "missing $dir/.env.example"
      failed=1
      continue
    fi
    docker compose --env-file "$dir/.env.example" -f "$f" config -q || failed=1
  done
  return "$failed"
}

step_gitleaks() {
  need gitleaks || return 1
  if gitleaks dir --help >/dev/null 2>&1; then
    gitleaks dir . --no-banner --redact
  else
    gitleaks detect --no-git --source . --no-banner --redact
  fi
}

step_private-addresses() {
  local pattern='(^|[^0-9.])(10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|192\.168\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3})([^0-9]|$)'
  local hits
  hits="$(git grep -nIE --untracked "$pattern" -- . ':!aws' ':!bootstrap' ':!kai/docs' || true)"
  if [[ -n "$hits" && -f .check-allow-private-addresses ]]; then
    hits="$(echo "$hits" | grep -vEf .check-allow-private-addresses || true)"
  fi
  if [[ -n "$hits" ]]; then
    echo "private addresses found:"
    echo "$hits"
    return 1
  fi
  return 0
}

run_step() {
  local name="$1"
  local fn="step_$name"
  local output rc
  output="$("$fn" 2>&1)" || rc=$?
  rc=${rc:-0}
  case "$rc" in
  0)
    echo "[PASS] $name"
    ;;
  2)
    echo "[SKIP] $name (nothing to check)"
    ;;
  *)
    echo "[FAIL] $name"
    if [[ -n "$output" ]]; then
      printf '%s\n' "$output" | sed 's/^/    /'
    fi
    failures=$((failures + 1))
    ;;
  esac
}

main() {
  local only=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --only)
      if [[ $# -lt 2 ]]; then
        usage
        exit 1
      fi
      only="$2"
      shift 2
      ;;
    *)
      usage
      exit 1
      ;;
    esac
  done

  local all_steps=(ansible-lint yamllint shellcheck compose gitleaks private-addresses)
  local failures=0

  if [[ -n "$only" ]]; then
    local found=0
    for s in "${all_steps[@]}"; do
      if [[ "$s" == "$only" ]]; then
        found=1
        break
      fi
    done
    if [[ $found -eq 0 ]]; then
      usage
      exit 1
    fi
    run_step "$only"
  else
    for s in "${all_steps[@]}"; do
      run_step "$s"
    done
  fi

  if [[ $failures -eq 0 ]]; then
    echo "check: all steps passed"
    exit 0
  else
    echo "check: $failures step(s) failed"
    exit 1
  fi
}

main "$@"
